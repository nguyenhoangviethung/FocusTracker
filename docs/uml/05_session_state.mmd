flowchart TD
    %% State definitions
    StartNode((( )))
    Idle(["Idle<br/>(Trạng thái chờ)"])
    Initializing(["Initializing<br/>(Khởi tạo)"])
    
    %% Left column
    TrackingLocal(["TrackingLocal<br/>(Theo dõi Ngoại tuyến)"])
    PausedLocal(["PausedLocal<br/>(Tạm dừng Ngoại tuyến)"])
    
    %% Center column
    Reconnecting(["Reconnecting<br/>(Đang kết nối lại)"])
    Completing(["Completing<br/>(Đang kết thúc)"])
    
    %% Right column
    TrackingCloud(["TrackingCloud<br/>(Theo dõi Đám mây)"])
    PausedCloud(["PausedCloud<br/>(Tạm dừng Đám mây)"])
    
    EndNode((( )))
    
    %% Layout constraints to force planar structure
    Initializing ~~~ Reconnecting
    Reconnecting ~~~ Completing
    
    TrackingLocal ~~~ Reconnecting
    Reconnecting ~~~ TrackingCloud
    
    PausedLocal ~~~ Completing
    Completing ~~~ PausedCloud
    
    %% Transitions
    StartNode --> Idle
    Idle -- "Bắt đầu" --> Initializing
    Initializing -- "Lỗi thiết bị" --> Idle
    
    %% Initial state dispatch
    Initializing -- "Chế độ Offline" --> TrackingLocal
    Initializing -- "Chế độ Cloud" --> TrackingCloud
    
    %% Connection recovery (horizontal)
    TrackingCloud <--> |"Mất mạng / Kết nối"| Reconnecting
    Reconnecting -- "Hết giờ" --> TrackingLocal
    
    %% Loops (vertical local columns)
    TrackingLocal <--> |"Tạm dừng / Tiếp tục"| PausedLocal
    TrackingCloud <--> |"Tạm dừng / Tiếp tục"| PausedCloud
    
    %% Completion flow (converging at bottom center)
    TrackingLocal -- "Kết thúc" --> Completing
    PausedLocal -- "Kết thúc" --> Completing
    
    TrackingCloud -- "Kết thúc" --> Completing
    PausedCloud -- "Kết thúc" --> Completing
    
    Completing --> EndNode
    
    %% Styling
    style StartNode fill:#334155,stroke:#334155
    style EndNode fill:#334155,stroke:#334155
    
    style Idle fill:#F8FAFC,stroke:#64748B,stroke-width:1.5px,color:#334155
    style PausedLocal fill:#F8FAFC,stroke:#64748B,stroke-width:1.5px,color:#334155
    style PausedCloud fill:#F8FAFC,stroke:#64748B,stroke-width:1.5px,color:#334155
    
    style Initializing fill:#EFF6FF,stroke:#3B82F6,stroke-width:2px,color:#1E40AF
    style Reconnecting fill:#FFFBEB,stroke:#F59E0B,stroke-width:2px,color:#78350F
    style Completing fill:#EFF6FF,stroke:#3B82F6,stroke-width:2px,color:#1E40AF
    
    style TrackingCloud fill:#ECFDF5,stroke:#10B981,stroke-width:2px,color:#065F46
    style TrackingLocal fill:#ECFDF5,stroke:#10B981,stroke-width:2px,color:#065F46
