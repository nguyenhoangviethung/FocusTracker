    subgraph ACTORS["Tác nhân (Actors)"]
        direction TB
        A1["👤 Người học<br/><i>(Learner)</i>"]
        A2["👥 Giám sát<br/><i>(Supervisor)</i>"]
        A3["🔑 Quản trị viên<br/><i>(Administrator)</i>"]
    end

    %% System Boundary
    subgraph SYSTEM["HỆ THỐNG FOCUSFLOW AI"]
        direction TB

        subgraph PKG1["📋 Phân hệ Cá nhân (Personal Session Management)"]
            UC1(["Cấu hình phiên học"])
            UC2(["Bắt đầu phiên theo dõi"])
            UC3(["Phân tích sự tập trung"])
            UC4(["Tạm dừng / Tiếp tục"])
            UC5(["Kết thúc và lưu trữ"])
            UC6(["Xem báo cáo cá nhân"])
        end

        subgraph PKG2["🛡️ Phân hệ Xác thực (Security & Identity)"]
            UC7(["Đăng nhập / Đăng ký"])
        end

        subgraph PKG3["📊 Phân hệ Quản trị (Administration & Monitoring)"]
            UC8(["Giám sát học viên realtime"])
            UC9(["Xem dashboard tổng hợp"])
            UC10(["Quản trị tài khoản & phiên"])
        end
    end

    %% Relationships
    A1 --- UC1
    A1 --- UC2
    A1 --- UC3
    A1 --- UC4
    A1 --- UC5
    A1 --- UC6

    UC2 -.->|"«include»"| UC7
    UC5 -.->|"«include»"| UC6

    A2 --- UC8
    A2 --- UC9
    A3 --- UC10

    UC8 -.->|"«include»"| UC9

