    classDef includeStyle fill:#F0FDF4,stroke:#16A34A,stroke-width:1.5px,color:#166534,rx:20px,ry:20px;
    classDef systemStyle fill:#FCFDFE,stroke:#0F172A,stroke-width:2.5px,color:#0F172A;
    classDef pkgStyle fill:#F8FAFC,stroke:#CBD5E1,stroke-width:1.5px,stroke-dasharray: 5 5,color:#334155;
    classDef actorsStyle fill:#F1F5F9,stroke:#64748B,stroke-width:1.5px,color:#334155;

    class A1,A2,A3 actorStyle;
    class UC1,UC2,UC3,UC4,UC5 useCaseStyle;
    class UC6,UC7,UC8,UC9,UC10 includeStyle;
    class SYSTEM systemStyle;
    class PKG1,PKG2,PKG3 pkgStyle;
