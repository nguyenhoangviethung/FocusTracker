classDiagram
    direction TB

    class User {
        +string user_id
        +string email
        +string display_name
        +datetime created_at
    }

    class SessionRecord {
        +string session_id
        +string user_id
        +string status
        +datetime started_at
        +datetime ended_at
    }

    class LiveMetrics {
        +float current_score
        +string current_state
        +datetime updated_at
    }

    class SessionSummary {
        +int duration_seconds
        +float average_focus
        +int distraction_count
        +bool completed
    }

    User "1" --> "*" SessionRecord : owns
    SessionRecord *-- LiveMetrics : embeds
    SessionRecord *-- SessionSummary : embeds

    %% Styling
    classDef entityStyle fill:#ECFDF5,stroke:#10B981,stroke-width:1.5px,color:#065F46
    classDef valueStyle fill:#FEF3C7,stroke:#D97706,stroke-width:1.5px,color:#92400E

    class User entityStyle
    class SessionRecord entityStyle
    class LiveMetrics valueStyle
    class SessionSummary valueStyle
